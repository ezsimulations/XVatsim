-    if (!PointInRing(latitudeDeg, longitudeDeg, polygon.rings.front())) {
-        return false;
-    }
-    for (std::size_t index = 1; index < polygon.rings.size(); ++index) {
-        if (PointInRing(latitudeDeg, longitudeDeg, polygon.rings[index])) {
-            return false;
-        }
-    }
-    return true;
-}
