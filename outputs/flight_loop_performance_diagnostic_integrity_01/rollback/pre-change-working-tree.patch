-double UnwrapLongitudeRelativeDeg(double referenceLongitudeDeg, double longitudeDeg) {
-    auto delta = longitudeDeg - referenceLongitudeDeg;
-    while (delta > 180.0) {
-        delta -= 360.0;
-    }
-    while (delta < -180.0) {
-        delta += 360.0;
-    }
-    return referenceLongitudeDeg + delta;
-}
