-    brain::StationRole role) {
-    if (authority.kind != brain::AuthorityRelevanceKind::Terminal ||
-        authority.proofSource != "AIRPORT_LOCAL_FACILITY") {
-        return false;
-    }
-
-    if (!AuthorityValueMatchesAny(authority.polygonKey, airportTokens)) {
