+bool HasOperationalDirectTerminalCandidate(
+    const BrainControllerRelevanceWorkerInput& input,
+    const BrainTerminalAuthorityWorkerOutput& authority,
+    const std::string& airport,
+    const RadioReachableControllerCandidate* excluded) {
+    for (const auto& other : input.candidates) {
