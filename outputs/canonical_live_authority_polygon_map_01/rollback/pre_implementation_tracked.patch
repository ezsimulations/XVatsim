+        const auto operational = EvaluateOperationalEligibility(other);
+        if (!operational.eligible || operational.atis) continue;
+        const auto* vnasRecord = FindVnasRecord(input, other, airport);
+        if (vnasRecord != nullptr &&
+            vnasRecord->ownershipFactsComplete &&
+            !vnasRecord->serviceCompatible) {
+            continue;
+        }
+        const auto polygon = EvaluateTerminalPolygonRelationship(
+            other, authority, Role(other));
