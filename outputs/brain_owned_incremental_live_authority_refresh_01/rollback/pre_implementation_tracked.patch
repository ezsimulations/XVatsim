-        return;
-    }
-
-    if (IsGuardFrequency(station.frequency)) {
-        return;
-    }
-
-    auto key = station.callsign + "|" + NormalizeFrequency(station.frequency);
-    if (key == "|") {
-        key = station.callsign;
-    }
-
-    if (!keys->insert(key).second) {
