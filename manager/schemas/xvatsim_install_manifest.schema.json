{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ezsimulations.github.io/XVatsim/schemas/xvatsim_install_manifest.schema.json",
  "title": "XVatsim Manager Installation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productVersion",
    "createdUtc",
    "supportedXPilot4ProductVersionPrefixes",
    "supportedXPilot4SimulatorPluginSha256",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "productVersion": { "type": "string", "minLength": 1 },
    "createdUtc": { "type": "string", "format": "date-time" },
    "supportedXPilot4ProductVersionPrefixes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "supportedXPilot4SimulatorPluginSha256": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relativePath", "target", "length", "sha256", "required"],
        "properties": {
          "relativePath": { "type": "string", "minLength": 1 },
          "target": { "enum": ["XPlane", "XPilot4"] },
          "length": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "required": { "type": "boolean" }
        }
      }
    }
  }
}
