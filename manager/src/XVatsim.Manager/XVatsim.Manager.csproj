<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>XVatsimManager</AssemblyName>
    <RootNamespace>XVatsim.Manager</RootNamespace>
    <Version>2.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\XVatsim.Manager.Core\XVatsim.Manager.Core.csproj" />
    <EmbeddedResource Include="..\..\generated\payload.zip" LogicalName="XVatsim.Manager.payload.zip" Condition="Exists('..\..\generated\payload.zip')" />
    <Resource Include="Assets\ez-simulations-logo.png" />
  </ItemGroup>
</Project>
