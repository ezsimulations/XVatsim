<Window x:Class="XVatsim.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XVatsim Manager" Width="820" Height="800" MinWidth="720" MinHeight="610"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}">
    <Grid Margin="34,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="XVatsim Manager" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Install, update, or repair XVatsim with verified files and automatic rollback."
                           Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
            <Image Grid.Column="1" Source="/XVatsimManager;component/Assets/ez-simulations-logo.png"
                   Width="104" Height="86" Stretch="Uniform" Margin="34,0,4,0"
                   VerticalAlignment="Center" HorizontalAlignment="Right"
                   SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"
                   ToolTip="EZ Simulations"/>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="20" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="X-Plane 12 installation" FontSize="13" FontWeight="SemiBold"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="XPlaneSelector" MinHeight="38" FontSize="14" DisplayMemberPath="RootPath"
                              SelectionChanged="XPlaneSelector_OnSelectionChanged"/>
                    <Button x:Name="ChooseFolderButton" Grid.Column="1" Content="Choose folder" Margin="10,0,0,0"
                            Click="ChooseFolder_OnClick"/>
                </Grid>
                <TextBlock x:Name="XPlaneHint" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="20" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="xPilot installation" FontSize="13" FontWeight="SemiBold"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="XPilotFolderText" IsReadOnly="True" MinHeight="40" Padding="12,8"
                             Background="{StaticResource ControlBrush}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="#46657A" BorderThickness="1" FontSize="14"/>
                    <Button x:Name="ChooseXPilotFolderButton" Grid.Column="1" Content="Choose folder"
                            Margin="10,0,0,0" Click="ChooseXPilotFolder_OnClick"/>
                </Grid>
                <TextBlock x:Name="XPilotStatus" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="ActionTitle" Text="Checking this computer" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ActionSummary" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               FontSize="14" Margin="0,7,0,14"/>
                    <StackPanel x:Name="WarningsPanel"/>
                    <ProgressBar x:Name="WorkProgress" Height="5" IsIndeterminate="True" Margin="0,12,0,12"/>
                    <TextBlock x:Name="ProgressText" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                    <Border x:Name="InstallProgressPanel" Visibility="Collapsed" Background="{StaticResource ControlBrush}"
                            BorderBrush="#46657A" BorderThickness="1" CornerRadius="7" Padding="16"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Installation progress" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="InstallProgressPercent" Grid.Column="1" Text="0%"
                                           Foreground="{StaticResource WarmHighlightBrush}" FontWeight="SemiBold"/>
                            </Grid>
                            <TextBlock x:Name="InstallProgressStatus" Text="Preparing the installation"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,9"/>
                            <ProgressBar x:Name="InstallProgressBar" Height="12" Minimum="0" Maximum="100"
                                         Value="0" IsIndeterminate="False" Foreground="{StaticResource AccentBrush}"
                                         Background="#24384A"/>
                            <TextBlock Text="Please keep this window open while the verified files are installed."
                                       Foreground="#879CA9" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>
                    <Expander Header="Advanced details" Margin="0,16,0,0" Foreground="{StaticResource TextBrush}">
                        <StackPanel>
                            <TextBox x:Name="AdvancedDetails" IsReadOnly="True" TextWrapping="Wrap"
                                     Background="#0C141C" Foreground="{StaticResource MutedBrush}" BorderThickness="0"
                                     Padding="12" MinHeight="120" VerticalScrollBarVisibility="Auto"/>
                            <TextBlock Text="Use installation diagnostics only when troubleshooting or contacting support."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,8"/>
                            <Button Content="Export installation diagnostics" HorizontalAlignment="Left"
                                    Click="SaveReport_OnClick"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,18,0,0" Orientation="Horizontal">
            <Button x:Name="PrimaryAction" Content="Please wait" IsEnabled="False" Click="PrimaryAction_OnClick"
                    Background="{StaticResource AccentBrush}" Foreground="#071217" BorderThickness="0" MinWidth="145"/>
        </StackPanel>
    </Grid>
</Window>
