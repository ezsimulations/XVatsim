name=Route Sector Stale Does Not Populate Enroute Board
now_seconds=1000

xpilot.connected=true

route.current_sector=identifier=KZLA;entryDistanceNm=0;matchTokens=KZLA;controllerPrefixes=LAX
route.next_sector=identifier=KZAB;entryDistanceNm=250;matchTokens=KZAB;controllerPrefixes=ABQ
route.stale=true

controller.entry=callsign=LAX_CTR;frequency=125.800;facility=6;actionable=true;atis=false
controller.entry=callsign=ABQ_CTR;frequency=127.850;facility=6;actionable=true;atis=false

expect.enroute_available=false
expect.enroute_callsigns=<none>
