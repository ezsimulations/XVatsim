name=Authority cache reuses proof for route scope source churn
now_seconds=1000

xpilot.connected=true

aircraft.valid=true
aircraft.on_ground=false
aircraft.latitude_deg=0.0
aircraft.longitude_deg=0.0

plan.departure_icao=KAAA
plan.stale=false
plan.departure_lat=0.0
plan.departure_lon=0.0
plan.has_departure_coordinates=true
plan.destination_icao=KBBB
plan.destination_lat=0.0
plan.destination_lon=1.2
plan.has_destination_coordinates=true

controller.feed_generation=12
controller.entry=callsign=MMZT_CTR;frequency=128.300;facility=6;actionable=true;atis=false
controller.entry=callsign=WATCH_OBS;frequency=126.000;facility=6;actionable=true;atis=false

resolver.route_resolve=true
resolver.center_feature=label=MMZT;tokens=MMZT;polygon=-1,-0.5|-1,1.5|1,1.5|1,-0.5
resolver.authority_catalog_fir=MMZT|Mazatlan||MMZT
resolver.ownership_json={"positions":[{"id":"MMZT_CTR","polygon_key":"MMZT","kind":"center","callsign_patterns":["MMZT_CTR"]}]}
resolver.authority_repeat_cache_age_seconds=999
resolver.authority_repeat_controller.replace=true
resolver.authority_repeat_controller.feed_generation=107
resolver.authority_repeat_controller.entry=callsign=MMZT_CTR;frequency=128.300;facility=6;actionable=true;atis=false
resolver.authority_repeat_controller.entry=callsign=UNRELATED_OBS;frequency=126.000;facility=6;actionable=true;atis=false

expect.resolver_route_available=true
expect.resolver_route_resolved=true
expect.resolver_authority_cache_status=authority-proof-build
expect.resolver_authority_cache_reason=no-authority-cache
expect.resolver_authority_repeat_cache_status=authority-cache-stable-proof-reuse
expect.resolver_authority_repeat_cache_reason=stable-proof-ownership-unchanged
expect.resolver_authority_repeat_relevant_matches=MMZT_CTR:VATGLASSES:MMZT_CTR:VATSPY_BOUNDARY:MMZT:aircraft=1:route=1:entry=0
