name=Departure Terminal Consumes Authority Snapshot
now_seconds=1000

xpilot.connected=true
flight.departure_icao=KONT
flight.destination_icao=KPHL
authority.board_handoff=true

aircraft.valid=true
aircraft.latitude_deg=0.0
aircraft.longitude_deg=0.0

route.waypoint=ident=ACFT;lat=0.0;lon=0.0
route.waypoint=ident=DEST;lat=0.0;lon=2.0

departure.coverage.available=true
departure.coverage.has_terminal=true
departure.coverage.sector=identifier=SCT;entryDistanceNm=0;matchTokens=SCT_APP;terminalCoverage=true

authority_position.tracon=id=SCT_APP;polygon=SCT_APP;patterns=SCT_APP;kind=terminal
authority_polygon.tracon=id=SCT;suffix=APP;prefixes=SCT;polygon=-1,-1|-1,1|1,1|1,-1

controller.entry=callsign=SCT_APP;frequency=128.050;facility=5;actionable=true;atis=false

expect.departure_collected_available=true
expect.departure_collected_callsigns=SCT_APP
expect.arrival_airspace_available=false
expect.arrival_airspace_callsigns=<none>
