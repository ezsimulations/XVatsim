name=CTAF UNICOM bypass retirement empty frequency blocked

ctaf_unicom.probe=true
ctaf_unicom.stage=Departure
ctaf_unicom.departure=airport=KAAA;attempted=true;cacheHit=true;requestSucceeded=true;status=2xx;resolved=true;available=true;frequency=;age=12;failures=0
ctaf_unicom.arrival=airport=KBBB;attempted=true;cacheHit=true;requestSucceeded=true;status=2xx;resolved=true;available=true;frequency=;age=20;failures=0

expect.ctaf_unicom_bypass_audit_summary=audit=2,legacyDiagnosticBypassRows=2,brainRows=0,matching=0,missing=0,mismatch=2,safe=0,blocked=2,pending=0,failed=0,empty=2,unicom=0,standbyAdvisory=2,standbyBypass=0,policy=2,resolvedBlockers=2,stillBlocked=0,policyNonDisplayable=2,policyDeferred=0,policyFailed=0,policyEmpty=2,duplicateSuppressed=0,missingEvidencePolicy=0,wouldLoseFrequency=0,wouldLoseVisibility=0,bypassSafe=2,bypassUnsafe=0,bypassRetired=1,liveBypassAuthority=0,diagnosticBypassRows=2,brainAdvisoryLive=0,missingEvidenceWarningCount=0,fallbackWarnings=0,missingEvidenceWarnings=0,duplicateLiveRows=0,pendingNonDisplayable=0,failedNonDisplayable=0,emptyNonDisplayable=2,retiredCompatibilityRows=2,retirementSafe=1,noLiveBypassAuthority=1,compatibilityRowsDiagnosticOnly=1,liveRowsBrainAdvisoryOwned=1,standbyRowsAdvisoryOwned=1,legacyBypassFieldsQuarantined=1,diagnosticCompatibilityProjectionOnly=1,legacyCompatibilityOnly=1,ready=1
