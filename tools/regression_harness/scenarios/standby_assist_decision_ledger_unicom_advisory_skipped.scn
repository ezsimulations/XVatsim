radio.valid=true

expect.standby_assist_decisions_contains=sourceDecision=ctaf-unicom-preview:departure:KAAA,role=UNICOM,fallback=1,final=skip-role-not-eligible,sourceDecision=ctaf-unicom-preview:arrival:KBBB,role=UNICOM,fallback=1,final=skip-role-not-eligible
