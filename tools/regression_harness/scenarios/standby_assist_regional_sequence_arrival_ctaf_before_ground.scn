ctaf_unicom.arrival=airport=KONT;attempted=true;cacheHit=true;requestSucceeded=true;status=2xx;resolved=true;available=true;frequency=123.050;age=12;failures=0

arrival.station=role=Ground;callsign=ONT_GND;frequency=121.900;online=true
arrival.station=role=Ctaf;callsign=KONT;frequency=123.050;online=true

radio.valid=true
standby_assist.apply=true
