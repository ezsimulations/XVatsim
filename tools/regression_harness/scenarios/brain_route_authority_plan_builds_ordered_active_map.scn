name=Brain Route Authority Plan Builds Ordered Active Map
now_seconds=1000

xpilot.connected=true
controller.feed_available=true
controller.feed_stale=false

aircraft.valid=true
aircraft.on_ground=false
aircraft.battery_on=true
aircraft.latitude_deg=0.0
aircraft.longitude_deg=0.0

plan.matched=true
plan.stale=false
plan.matched_callsign=DAL100
plan.departure_icao=KAAA
plan.departure_lat=0.0
plan.departure_lon=0.0
plan.has_departure_coordinates=true
plan.destination_icao=KDDD
plan.destination_lat=0.0
plan.destination_lon=30.0
plan.has_destination_coordinates=true

resolver.route_resolve=true
resolver.center_feature=label=AAA;tokens=AAA;polygon=-1,-1|-1,5|1,5|1,-1
resolver.center_feature=label=BBB;tokens=BBB;polygon=-1,10|-1,15|1,15|1,10
resolver.center_feature=label=CCC;tokens=CCC;polygon=-1,20|-1,25|1,25|1,20
resolver.authority_catalog_fir=AAA|Alpha||AAA_CTR
resolver.authority_catalog_fir=BBB|Bravo||BBB_CTR
resolver.authority_catalog_fir=CCC|Charlie||CCC_CTR
resolver.ownership_json={"positions":[{"id":"AAA_CTR","polygon_key":"AAA","kind":"center","callsign_patterns":["AAA_CTR"]},{"id":"BBB_CTR","polygon_key":"BBB","kind":"center","callsign_patterns":["BBB_CTR"]},{"id":"CCC_CTR","polygon_key":"CCC","kind":"center","callsign_patterns":["CCC_CTR"]}]}

expect.resolver_route_available=true
expect.resolver_route_resolved=true
expect.resolver_route_current_sectors=AAA
expect.resolver_route_next_sectors=BBB,CCC
expect.route_authority_plan_sequence=AAA,BBB,CCC
expect.route_authority_plan_flags=AAA:current,BBB:next,CCC:arrival
expect.route_authority_plan_sources=AAA:coverage=C:owned=1:patterns=1:prefixes=0,BBB:coverage=C:owned=1:patterns=1:prefixes=0,CCC:coverage=C:owned=1:patterns=1:prefixes=0
