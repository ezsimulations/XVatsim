name=CTAF UNICOM missing evidence audit missing departure source

ctaf_unicom.probe=true
ctaf_unicom.stage=Departure
ctaf_unicom.departure=airport=KAAA;attempted=true;cacheHit=true;requestSucceeded=true;status=2xx;resolved=true;available=true;frequency=122.950;age=12;failures=0
ctaf_unicom.arrival=airport=KBBB;attempted=true;cacheHit=true;requestSucceeded=true;status=2xx;resolved=true;available=true;frequency=123.450;age=20;failures=0
ctaf_unicom.omit_departure_source_evidence=true

expect.ctaf_unicom_missing_evidence_audit_summary=audit=1,missingSource=1,missingAdvisory=1,incompleteAdvisory=0,oldCompatibilityWouldDisplay=1,wouldLoseFrequency=1,wouldLoseVisibility=1,warningOnly=1,liveAuthorityRestored=0,liveCompatibilityFallbackUsed=0,standbyConsumesWarning=0,authorityInvariantPreserved=1,operatorActionRequired=1
expect.ctaf_unicom_missing_evidence_audit_decisions_contains=id=ctaf-unicom-missing-evidence-audit:departure:KAAA,endpoint=departure:airport=KAAA:role=CTAF:freq=122.950,cause=missing-source-evidence,missingSource=1:missingAdvisory=1:incompleteAdvisory=0,oldCompatibilityWouldDisplay=1:wouldLoseFrequency=1:wouldLoseVisibility=1,warningOnly=1:warningLabel=missing-evidence-warning-only:warningReason=missing-source-evidence:recoveryHint=restore-ctaf-unicom-source-evidence,liveAuthorityRestored=0:liveCompatibilityFallbackUsed=0:standbyConsumesWarning=0:standbyWriteBlockedByMissingEvidence=1,authorityInvariantPreserved=1:failSoftVisible=1:operatorActionRequired=1
