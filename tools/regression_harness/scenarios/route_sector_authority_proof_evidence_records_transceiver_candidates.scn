expect.resolver_authority_transceiver_proof_evidence_contains=BEST_CTR:stationCount=2:station=BEST_CTR@130.000:polygon=TEST:src=VATSPY_BOUNDARY:kind=center:dist=0:tol=350:within=1:owner=1:unownedBorder=0:blocked=0:noStation=0:score=100:bestScore=1:oldProof=1:reason=<none>,BEST_CTR:stationCount=2:station=BEST_CTR@130.000:polygon=TEST:src=VATSPY_BOUNDARY:kind=center:dist=0:tol=350:within=1:owner=1:unownedBorder=0:blocked=0:noStation=0:score=50:bestScore=0:oldProof=0:reason=not-best-transceiver-route-proof,NOSTA_CTR:stationCount=0:station=@:polygon=:src=:kind=:dist=0:tol=0:within=0:owner=0:unownedBorder=0:blocked=0:noStation=1:score=0:bestScore=0:oldProof=0:reason=no-station-candidates,REMOTE_CTR:stationCount=1:station=REMOTE_CTR@132.000:polygon=TEST:src=VATSPY_BOUNDARY:kind=center:dist=2402:tol=350:within=0:owner=1:unownedBorder=0:blocked=0:noStation=0:score=75:bestScore=1:oldProof=0:reason=over-tolerance
