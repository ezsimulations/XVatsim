name=Route Sector Authority Proof Evidence Records Transceiver Candidates
now_seconds=1000

xpilot.connected=true

aircraft.valid=true
aircraft.on_ground=false
aircraft.latitude_deg=0.5
aircraft.longitude_deg=0.5

plan.departure_icao=KAAA
plan.stale=false
plan.departure_lat=0.5
plan.departure_lon=0.0
plan.has_departure_coordinates=true
plan.destination_icao=KBBB
plan.destination_lat=0.5
plan.destination_lon=1.0
plan.has_destination_coordinates=true

radio.com1_active=118.000
radio.com2_active=122.800

controller.entry=callsign=BEST_CTR;frequency=130.000;facility=6;actionable=true;atis=false
controller.entry=callsign=NOSTA_CTR;frequency=131.000;facility=6;actionable=true;atis=false
controller.entry=callsign=REMOTE_CTR;frequency=132.000;facility=6;actionable=true;atis=false

transceiver.available=true
transceiver.stale=false
transceiver.candidate=callsign=BEST_CTR;frequency=130.000;lat=0.5;lon=0.5;score=100
transceiver.candidate=callsign=BEST_CTR;frequency=130.000;lat=0.6;lon=0.6;score=50
transceiver.candidate=callsign=REMOTE_CTR;frequency=132.000;lat=30.0;lon=30.0;score=75

resolver.route_resolve=true
resolver.center_feature=label=TEST;tokens=TEST;polygon=0,0|1,0|1,1|0,1
resolver.authority_catalog_fir=TEST|Test Center||TEST

expect.resolver_route_available=true
expect.resolver_route_resolved=true
expect.resolver_route_current_sectors=TEST
expect.resolver_authority_relevance_available=true
expect.resolver_authority_evidence_visibility=scheduled=1,source=3,evidence=3,dropped=0,compatOnly=1,compatRelevant=1,feed=1/0,route=1/0/1,stage=ARRIVAL_PREP,window=200,deferred=0,routeKeys=1,matchKeys=2,tx=1/1/0/3
