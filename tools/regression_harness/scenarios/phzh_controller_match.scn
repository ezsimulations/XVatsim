# Replays the Honolulu authority-match class of bug without requiring live ATC timing.
name=PHZH Controller Match
now_seconds=1000

state.flight_active=true
state.departure_released=true
state.arrival_awake=false
state.airborne_since_seconds=400

flight.callsign=UPS2185
flight.departure_icao=KONT
flight.departure_lat=34.0560
flight.departure_lon=-117.6010
