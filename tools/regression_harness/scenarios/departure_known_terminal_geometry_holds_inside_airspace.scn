# Proves known terminal containment with a live APP/DEP controller owns Departure.
name=Departure Known Terminal Geometry Holds Inside Airspace
now_seconds=1000

state.flight_active=true
state.departure_released=false
state.arrival_awake=false
state.airborne_since_seconds=700

flight.callsign=UPS2066
flight.departure_icao=KONT
flight.departure_lat=34.0560
flight.departure_lon=-117.6010
flight.has_departure_coordinates=true
flight.destination_icao=KPHL
flight.destination_lat=39.8744
flight.destination_lon=-75.2424
flight.has_destination_coordinates=true

aircraft.valid=true
aircraft.on_ground=false
aircraft.battery_on=true
aircraft.latitude_deg=34.1000
aircraft.longitude_deg=-117.7000

radio.com1_active=122.800

departure.terminal_coverage_known=true
departure.inside_terminal_coverage=true

departure.station=role=Approach;callsign=SCT_APP;frequency=128.050;online=true;offline=false

enroute.station=role=Center;callsign=LAX_CTR;frequency=125.800;online=true;offline=false;sectorActive=true;routeEntryDistanceNm=0

expect.stage=Departure
expect.reason=departure-terminal-airspace
expect.display_source=Departure
expect.display_callsigns=SCT_APP,LAX_CTR
