name=Standby assist direct CTAF live gate on failed blocked

ctaf_unicom.probe=true
ctaf_unicom.stage=Departure
ctaf_unicom.departure=airport=KAAA;attempted=true;requestSucceeded=false;status=failure;resolved=false;available=false;age=60;failures=2;pending=lookup-failed
ctaf_unicom.arrival=airport=KBBB;attempted=true;requestSucceeded=false;status=failure;resolved=false;available=false;age=61;failures=3;pending=lookup-failed

standby_assist.apply=true
standby_assist.side_effect=true
standby_assist.enabled=true
standby_assist.direct_ctaf_enabled=true
standby_assist.stage=Departure
standby_assist.plan_key=HARNESS|KAAA|KBBB

radio.valid=true

expect.standby_assist_decisions_contains=sourceDecision=ctaf-unicom-preview:departure:KAAA,advisory=lookup-failed,previewRecommendation=preview-not-ready,liveWriteEligible=0,productGateEnabled=1,directCtafLivePromotionAllowed=0,livePromotionBlockedReason=skip-lookup-failed,actualSelectedTargetSource=none,actualWriteEligible=0,dryRunLiveEligible=0,dryRunLiveRecommendation=dry-run-not-ready,dryRunSkip=skip-lookup-failed,dryRunSafetyGate=frequency-state,dryRunBlockedByFrequencyState=1,dryRunPromotionClass=unknown,final=skip-lookup-failed
