expect.resolver_authority_polygon_evidence_contains=VATGLASSES:TEST-A_0:key=TEST-A_0:src=VATGLASSES:kind=center:routeKey=0:family=1:endpoint=0:scoped=1:geom=1:inside=1:route=1:entry=0:oldRelevant=1:scopedReason=<none>
