expect.resolver_authority_preview_summary=authority=brain-evidence,source=1,evidence=1,compatRelevant=1,previewSurvivors=1,previewRejected=2,oldMismatch=0,droppedBeforeBrain=0,compatOnly=1,liveOwned=1
expect.resolver_authority_preview_decisions_contains=active-polygon:FAM_CTR:TRANSCEIVER:FAM_CTR:VATGLASSES:TEST-A_0:TEST-A_0:TRANSCEIVER_GEO:130000:0nm:TRANSCEIVER_GEO_ROUTE:brain-preview-authority-relevance-survivor:old-relevant-authority:old=1,active-polygon:FAM_CTR:VATGLASSES:FAM1:VATGLASSES:TEST-A_0:TEST-A_0:FAM_CTR:VATGLASSES_DYNAMIC_OWNER:brain-preview-authority-relevance-rejected-active-not-relevant:active-not-relevant:old=0,transceiver-proof:FAM_CTR:<empty>:VATSPY_BOUNDARY:TEST:TEST:<empty>:TRANSCEIVER_GEO_ROUTE:brain-preview-authority-relevance-rejected-transceiver-proof:not-best-transceiver-route-proof:old=0
