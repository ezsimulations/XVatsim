resolver.authority_catalog_fir=TEST|Test Control||TEST
resolver.ownership_json={"positions":{"FAM1":{"pre":["FAM"],"type":"CTR","frequency":"130.000","callsign":"Family Center"}},"airspace":{"TEST-A":{"id":"Test Family Child","group":"TEST-A","sectors":[{"points":[["000000","0000000"],["010000","0000000"],["010000","0010000"],["000000","0010000"]]}]}},"ownership":{"airspace":{"TEST-A":["FAM1"]}}}

