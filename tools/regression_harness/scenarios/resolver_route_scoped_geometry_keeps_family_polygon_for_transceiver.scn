expect.resolver_route_current_sectors=TEST
expect.resolver_authority_relevance_available=true
expect.resolver_authority_status=AUTHORITY candidates=1 authorities=2 polygons=2 routeKeys=1 active=1 relevant=1 diagnostics=1 activationGaps=0
