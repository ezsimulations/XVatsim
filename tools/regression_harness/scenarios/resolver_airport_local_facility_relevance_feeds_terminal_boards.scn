name=Resolver Airport Local Facility Relevance Feeds Terminal Boards
now_seconds=1000

xpilot.connected=true

aircraft.valid=true
aircraft.on_ground=true
aircraft.latitude_deg=0.0
aircraft.longitude_deg=0.0

flight.departure_icao=KAAA
flight.destination_icao=KBBB

plan.departure_icao=KAAA
plan.stale=false
plan.departure_lat=0.0
plan.departure_lon=0.0
plan.has_departure_coordinates=true
plan.destination_icao=KBBB
plan.destination_lat=0.0
plan.destination_lon=20.0
plan.has_destination_coordinates=true

radio.com1_active=121.900
radio.com2_active=122.800

controller.entry=callsign=AAA_DEL;frequency=121.700;facility=2;actionable=true;atis=false
controller.entry=callsign=AAA_GND;frequency=121.900;facility=3;actionable=true;atis=false
controller.entry=callsign=BBB_TWR;frequency=118.100;facility=4;actionable=true;atis=false

resolver.route_resolve=true
resolver.center_feature=label=TEST;tokens=TEST;polygon=-1,-1|-1,21|1,21|1,-1
resolver.authority_catalog_fir=TEST|Test Center|TST|TEST

expect.resolver_route_available=true
expect.resolver_route_resolved=true
expect.resolver_route_current_sectors=TEST
expect.resolver_authority_relevance_available=true
expect.resolver_authority_relevant_matches=AAA_DEL:AIRPORT_LOCAL:KAAA_DEL:AIRPORT_LOCAL:KAAA:aircraft=1:route=1:entry=0,AAA_GND:AIRPORT_LOCAL:KAAA_GND:AIRPORT_LOCAL:KAAA:aircraft=1:route=1:entry=0
expect.resolver_authority_proof_sources=AAA_DEL:AIRPORT_LOCAL_FACILITY,AAA_GND:AIRPORT_LOCAL_FACILITY
expect.resolver_authority_proof_detail_contains=AAA_DEL:authoritySource=AIRPORT_LOCAL,AAA_GND:authoritySource=AIRPORT_LOCAL,proofItems=airport-endpoint>callsign-pattern>facility-type
expect.resolver_enroute_available=false
expect.resolver_enroute_callsigns=<none>
