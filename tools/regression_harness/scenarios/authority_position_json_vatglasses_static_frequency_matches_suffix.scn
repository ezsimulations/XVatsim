name=Authority Position JSON VATGlasses Static Frequency Matches Suffix
now_seconds=1000

xpilot.connected=true
authority.enroute_handoff=true

authority_position_json.vatglasses={"airspace":[{"id":"Area Radar West","group":"VHHK","owner":["TRW"],"sectors":[]}],"positions":{"TRW":{"pre":["HKG"],"type":"CTR","frequency":"127.100","callsign":"Hong Kong Radar"}}}
authority_polygon.vatglasses=key=TRW;name=Hong Kong West;tokens=TRW,VHHK,HKG;polygon=-1.0,112.0|1.0,112.0|1.0,113.0|-1.0,113.0
controller.entry=callsign=HKG_W_CTR;frequency=127.100;facility=6;actionable=true;atis=false
route.waypoint=ident=A;lat=0.0;lon=110.0
route.waypoint=ident=B;lat=0.0;lon=114.0

expect.authority_catalog_ids=VATGLASSES:TRW
expect.authority_active_matches=HKG_W_CTR:VATGLASSES:TRW:TRW:HKG_*_CTR
expect.authority_active_polygon_matches=HKG_W_CTR:VATGLASSES:TRW:VATGLASSES:TRW:TRW:HKG_*_CTR
expect.authority_relevant_polygon_matches=HKG_W_CTR:VATGLASSES:TRW:VATGLASSES:TRW:aircraft=0:route=1:entry=120
expect.enroute_available=true
expect.enroute_callsigns=HKG_W_CTR
