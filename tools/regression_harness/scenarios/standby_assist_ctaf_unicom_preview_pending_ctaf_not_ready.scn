name=Standby assist CTAF UNICOM preview pending CTAF not ready

ctaf_unicom.probe=true
ctaf_unicom.stage=Departure
ctaf_unicom.departure=airport=KAAA;attempted=true;fetchInProgress=true;resolved=false;available=false;age=5;failures=0
ctaf_unicom.arrival=airport=KBBB;attempted=true;fetchInProgress=true;resolved=false;available=false;age=8;failures=0

standby_assist.apply=true
standby_assist.side_effect=true
standby_assist.enabled=true
standby_assist.stage=Departure
standby_assist.plan_key=HARNESS|KAAA|KBBB

radio.valid=true

expect.standby_assist_decisions_contains=sourceDecision=ctaf-unicom-preview:departure:KAAA,advisory=defer-pending,liveEligible=0,previewEligible=0,previewRecommendation=preview-not-ready,previewSkip=skip-pending-lookup,liveWriteEligible=0,advisoryWritePolicy=not-ready-no-write,advisoryFrequencyResolutionState=pending-lookup,advisoryCandidateType=pending-lookup,final=skip-pending-lookup
expect.standby_assist_side_effect_summary=sideEffect=standby-side-effect:no-target,standbyDecision=<none>,enabled=1,latchKey=<none>,latchConsumed=0,writeAllowed=0,writeAttempted=0,writeSucceededKnown=0,writeSucceeded=0,writerTarget=none,targetFrequency=<empty>,failure=no-target,marker=0
