name=Authority cache reuses proof on second route window transition
now_seconds=1000

xpilot.connected=true

aircraft.valid=true
aircraft.on_ground=false
aircraft.latitude_deg=0.0
aircraft.longitude_deg=0.8

plan.departure_icao=MMGL
plan.stale=false
plan.departure_lat=0.0
plan.departure_lon=0.0
plan.has_departure_coordinates=true
plan.destination_icao=KLAS
plan.destination_lat=0.0
plan.destination_lon=3.2
plan.has_destination_coordinates=true

controller.feed_generation=100
controller.entry=callsign=MMEX_CTR;frequency=126.600;facility=6;actionable=true;atis=false
controller.entry=callsign=MMZT_CTR;frequency=128.300;facility=6;actionable=true;atis=false
controller.entry=callsign=KZAB_CTR;frequency=124.325;facility=6;actionable=true;atis=false
controller.entry=callsign=LAX_251_CTR;frequency=126.525;facility=6;actionable=true;atis=false

resolver.route_resolve=true
resolver.center_feature=label=MMEX;tokens=MMEX;polygon=-1,-0.5|-1,0.5|1,0.5|1,-0.5
resolver.center_feature=label=MMZT;tokens=MMZT;polygon=-1,0.5|-1,1.5|1,1.5|1,0.5
resolver.center_feature=label=KZAB;tokens=KZAB;polygon=-1,1.5|-1,2.5|1,2.5|1,1.5
resolver.center_feature=label=KZLA;tokens=KZLA;polygon=-1,2.5|-1,3.5|1,3.5|1,2.5
resolver.authority_catalog_fir=MMEX|Mexico||MMEX
resolver.authority_catalog_fir=MMZT|Mazatlan||MMZT
resolver.authority_catalog_fir=KZAB|Albuquerque||KZAB
resolver.authority_catalog_fir=KZLA|Los Angeles||KZLA
resolver.ownership_json={"positions":[{"id":"MMEX_CTR","polygon_key":"MMEX","kind":"center","callsign_patterns":["MMEX_CTR"]},{"id":"MMZT_CTR","polygon_key":"MMZT","kind":"center","callsign_patterns":["MMZT_CTR"]},{"id":"KZAB_CTR","polygon_key":"KZAB","kind":"center","callsign_patterns":["KZAB_CTR"]},{"id":"LAX_251_CTR","polygon_key":"KZLA","kind":"center","callsign_patterns":["LAX_251_CTR"]}]}

resolver.authority_repeat_aircraft.valid=true
resolver.authority_repeat_aircraft.on_ground=false
resolver.authority_repeat_aircraft.latitude_deg=0.0
resolver.authority_repeat_aircraft.longitude_deg=1.8

expect.resolver_route_available=true
expect.resolver_route_resolved=true
expect.resolver_authority_cache_status=authority-proof-build
expect.resolver_authority_cache_reason=no-authority-cache
expect.resolver_authority_repeat_cache_status=authority-cache-window-reuse
expect.resolver_authority_repeat_cache_reason=route-window-proof-subset
expect.resolver_authority_repeat_relevant_matches=KZAB_CTR:VATGLASSES:KZAB_CTR:VATSPY_BOUNDARY:KZAB:aircraft=1:route=1:entry=0,LAX_251_CTR:VATGLASSES:LAX_251_CTR:VATSPY_BOUNDARY:KZLA:aircraft=0:route=1:entry=42
