<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>XVatsim.XPilot4Bridge.Probe</AssemblyName>
    <XPilotPluginSdkProject Condition="'$(XPilotPluginSdkProject)' == ''">$(MSBuildThisFileDirectory)..\..\build\_deps\xpilot-plugin-sdk\xPilot.PluginSdk.csproj</XPilotPluginSdkProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\integrations\xpilot4_bridge\XVatsim.XPilot4Bridge.csproj"
                      AdditionalProperties="XPilotPluginSdkProject=$(XPilotPluginSdkProject)" />
    <ProjectReference Include="$(XPilotPluginSdkProject)" />
  </ItemGroup>
</Project>
